{
  "name": "@hjdd14/dsh-together",
  "version": "0.1.0",
  "type": "module",
  "description": "Play a mini-game before the agent's next file change: 194 built-in games (2D and WebGL 3D) gate every write.",
  "license": "MIT",
  "author": "Hjdd14",
  "homepage": "https://github.com/Hjdd14/dsh-together#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hjdd14/dsh-together.git"
  },
  "bugs": {
    "url": "https://github.com/Hjdd14/dsh-together/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "mini-games",
    "games",
    "gate",
    "canvas",
    "webgl"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/*.js",
    "shared/*.js",
    "client-src/*.js",
    "client-src/games/*/*.js",
    "client-src/games/API.md",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "build.mjs",
    "test/*.mjs"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node --test test/gate.test.mjs test/history.test.mjs test/play.test.mjs test/games.smoke.test.mjs test/audit.test.mjs test/bundle.test.mjs"
  }
}
